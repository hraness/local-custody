{
  "contract": "hraness.local-custody-vectors/v1",
  "note": "Each case names the function under test, the arranged state, and the required outcome. A conforming port reproduces every outcome.",
  "ownedPath": [
    {
      "name": "private file within bounds",
      "arrange": { "kind": "file", "mode": "0600", "bytes": 5 },
      "expect": { "kind": "file", "exactMode": "0600", "maximumBytes": 16 },
      "outcome": "accept"
    },
    {
      "name": "group-readable file",
      "arrange": { "kind": "file", "mode": "0640" },
      "expect": { "kind": "file", "exactMode": "0600" },
      "outcome": "reject"
    },
    {
      "name": "symbolic link to private file",
      "arrange": { "kind": "symlink", "targetMode": "0600" },
      "expect": { "kind": "file" },
      "outcome": "reject"
    },
    {
      "name": "hard-linked alias",
      "arrange": { "kind": "file", "mode": "0600", "links": 2 },
      "expect": { "kind": "file" },
      "outcome": "reject"
    },
    {
      "name": "regular file where socket expected",
      "arrange": { "kind": "file", "mode": "0600" },
      "expect": { "kind": "socket" },
      "outcome": "reject"
    },
    {
      "name": "socket with permissive mode",
      "arrange": { "kind": "socket", "mode": "0660" },
      "expect": { "kind": "socket", "exactMode": "0600" },
      "outcome": "reject"
    }
  ],
  "privateDirectory": [
    {
      "name": "missing directory",
      "arrange": { "exists": false },
      "outcome": "created mode 0700"
    },
    {
      "name": "permissive existing directory",
      "arrange": { "mode": "0755" },
      "outcome": "reject"
    },
    {
      "name": "symlinked directory",
      "arrange": { "kind": "symlink" },
      "outcome": "reject"
    },
    {
      "name": "noncanonical parent",
      "arrange": { "parent": "symlink" },
      "outcome": "reject"
    }
  ],
  "stableRead": [
    {
      "name": "private file read stably",
      "arrange": { "kind": "file", "mode": "0600", "content": "payload" },
      "expect": { "maximumBytes": 64 },
      "outcome": "returns content plus dev/ino identity"
    },
    {
      "name": "content above bound",
      "arrange": { "kind": "file", "mode": "0600", "bytes": 200 },
      "expect": { "maximumBytes": 64 },
      "outcome": "reject"
    },
    {
      "name": "read-only mode under exactMode 0600",
      "arrange": { "kind": "file", "mode": "0400", "content": "v" },
      "expect": { "exactMode": "0600", "maximumBytes": 64 },
      "outcome": "reject"
    },
    {
      "name": "empty file under minimumBytes 1",
      "arrange": { "kind": "file", "mode": "0600", "bytes": 0 },
      "expect": { "minimumBytes": 1, "maximumBytes": 64 },
      "outcome": "reject"
    },
    {
      "name": "symlink path",
      "arrange": { "kind": "symlink", "targetMode": "0600" },
      "expect": { "maximumBytes": 64 },
      "outcome": "reject"
    },
    {
      "name": "object replaced during read",
      "arrange": { "kind": "file", "mode": "0600", "mutate": "rename-over during read" },
      "expect": { "maximumBytes": 64 },
      "outcome": "reject"
    }
  ],
  "publishName": [
    { "name": "capability", "outcome": "accept" },
    { "name": "state.v2.json", "outcome": "accept" },
    { "name": "../escape", "outcome": "reject" },
    { "name": "a/b", "outcome": "reject" },
    { "name": "", "outcome": "reject" },
    { "name": ".hidden", "outcome": "reject" },
    { "name": "..", "outcome": "reject" },
    { "name": "a b", "outcome": "reject" },
    { "name": "a\nb", "outcome": "reject" }
  ],
  "controlFrame": [
    {
      "name": "single complete request",
      "wire": "{\"ping\":1}\\n",
      "outcome": "one handler call, one bounded response line"
    },
    {
      "name": "unparsable frame",
      "wire": "not-json\\n",
      "outcome": "failure response, connection ends"
    },
    {
      "name": "empty frame",
      "wire": "\\n",
      "outcome": "failure response, connection ends"
    },
    {
      "name": "oversize frame without newline",
      "wire": "129 bytes with bound 64",
      "outcome": "connection destroyed"
    },
    {
      "name": "surplus pipelined frame past per-connection bound",
      "wire": "two frames with maximumRequestsPerConnection 1",
      "outcome": "failure response, connection ends"
    },
    {
      "name": "partial frame then EOF",
      "wire": "{\"ping\":1 then FIN",
      "outcome": "connection destroyed, no response"
    }
  ],
  "sidecarEnvelope": [
    {
      "name": "unknown op rejected",
      "request": { "op": "no-such-op" },
      "expect": { "ok": false, "code": "invalid-request" }
    },
    {
      "name": "non-string op rejected",
      "request": { "op": 123 },
      "expect": { "ok": false, "code": "invalid-request" }
    },
    {
      "name": "ensure private directory",
      "request": { "op": "ensure_private_directory", "path": "$TEMP/private" },
      "expect": { "ok": true, "fields": { "path": "$TEMP/private" } }
    },
    {
      "name": "atomic publish writes",
      "request": { "op": "atomic_publish", "dir": "$TEMP/private", "name": "state.json", "contentBase64": "eA==" },
      "expect": { "ok": true, "fields": { "created": true, "path": "$TEMP/private/state.json" } }
    },
    {
      "name": "atomic publish create-once preserves",
      "request": { "op": "atomic_publish", "dir": "$TEMP/private", "name": "state.json", "contentBase64": "eQ==", "createOnce": true },
      "expect": { "ok": true, "fields": { "created": false, "path": "$TEMP/private/state.json" } }
    },
    {
      "name": "assert owned path on published file",
      "request": { "op": "assert_owned_path", "path": "$TEMP/private/state.json", "kind": "file", "exactMode": "0600" },
      "expect": { "ok": true, "fields": { "size": 1 } }
    },
    {
      "name": "stable read returns content",
      "request": { "op": "stable_read", "path": "$TEMP/private/state.json", "maximumBytes": 64 },
      "expect": { "ok": true, "fields": { "size": 1, "contentBase64": "eA==" } }
    },
    {
      "name": "stable read exact mode mismatch",
      "request": { "op": "stable_read", "path": "$TEMP/private/state.json", "maximumBytes": 64, "exactMode": "0400" },
      "expect": { "ok": false, "code": "mode-mismatch" }
    },
    {
      "name": "assert owned path missing",
      "request": { "op": "assert_owned_path", "path": "$TEMP/private/missing", "kind": "file" },
      "expect": { "ok": false, "code": "stat" }
    },
    {
      "name": "unsafe publish name rejected",
      "request": { "op": "atomic_publish", "dir": "$TEMP/private", "name": "../escape", "contentBase64": "eA==" },
      "expect": { "ok": false, "code": "separator" }
    },
    {
      "name": "invalid base64 rejected",
      "request": { "op": "atomic_publish", "dir": "$TEMP/private", "name": "bad.txt", "contentBase64": "!!!" },
      "expect": { "ok": false, "code": "invalid-request" }
    },
    {
      "name": "negative descriptor rejected",
      "request": { "op": "read_protected_descriptor", "fd": -1 },
      "expect": { "ok": false, "code": "invalid" }
    },
    {
      "name": "non-regular descriptor rejected",
      "request": { "op": "read_protected_descriptor", "fd": 0, "maximumBytes": 64 },
      "expect": { "ok": false, "code": "kind" }
    },
    {
      "name": "control request to missing socket",
      "request": { "op": "control_socket_request", "socketPath": "$TEMP/private/no.sock", "request": {}, "maximumResponseBytes": 1024, "timeoutMs": 500 },
      "expect": { "ok": false, "code": "not-found" }
    }
  ],
  "protectedInput": [
    {
      "name": "private regular file",
      "arrange": { "kind": "file", "mode": "0600", "content": "token" },
      "expect": { "content": "token" }
    },
    {
      "name": "permissive regular file",
      "arrange": { "kind": "file", "mode": "0644", "content": "token" },
      "expect": { "code": "mode" }
    },
    {
      "name": "terminal descriptor",
      "arrange": { "kind": "tty" },
      "expect": { "code": "tty" }
    },
    {
      "name": "input beyond bound",
      "arrange": { "kind": "file", "mode": "0600", "bytes": 128, "bound": 64 },
      "expect": { "code": "limit" }
    },
    {
      "name": "negative descriptor",
      "arrange": null,
      "expect": { "code": "invalid" }
    }
  ]
}
